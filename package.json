{
  "name": "dsh-leanary",
  "version": "0.1.0-dev.2",
  "private": true,
  "description": "Leanary: a mathematical research plugin for DeepSeek Harness with persistent tasks and scoped Lean verification.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/QUICKSTART.md",
    "docs/DEVELOPMENT.md",
    "examples/order-bound"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.1-rc.3"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "pnpm run build",
    "trial:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-trial.ps1",
    "source:pack": "node scripts/build-source.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
